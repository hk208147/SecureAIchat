# Copy this file to .env and fill in values from Terraform outputs.
# Never commit .env to version control.

# Cognito User Pool ID (terraform output: cognito_user_pool_id)
VITE_USER_POOL_ID=ap-southeast-2_XXXXXXXXX

# Cognito App Client ID (terraform output: cognito_app_client_id)
VITE_USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Cognito Managed Login domain (terraform output: cognito_login_url base domain only)
# Format: <prefix>.auth.ap-southeast-2.amazoncognito.com
VITE_COGNITO_DOMAIN=personal-chat-app-<account-id>.auth.ap-southeast-2.amazoncognito.com

# HTTP API endpoint (terraform output: api_endpoint)
# Include trailing slash or omit — both are handled in chatApi.ts
VITE_API_ENDPOINT=https://xxxxxxxxxx.execute-api.ap-southeast-2.amazonaws.com
